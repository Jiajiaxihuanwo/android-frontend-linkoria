<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="5dp"
    android:paddingVertical="6dp">

    <!-- 1. SENT — 2 líneas -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/avatar_1"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:background="@drawable/shape_circle_avatar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/name_1"
                android:layout_width="60dp"
                android:layout_height="10dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/shape_shimmer_rect"
                app:layout_constraintEnd_toStartOf="@id/avatar_1"
                app:layout_constraintTop_toTopOf="@id/avatar_1" />

            <View
                android:id="@+id/bubble_1"
                android:layout_width="240dp"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/shape_bubble_sent"
                app:layout_constraintEnd_toStartOf="@id/avatar_1"
                app:layout_constraintTop_toBottomOf="@id/name_1" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- 2. SENT — 1 línea -->
